# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://brandplus.com.br"

# BRAND+ Operational SaaS URL (External application)
VITE_SAAS_APP_URL="https://app.brandplus.com.br"

# API Base URL for backend integration
VITE_API_BASE_URL="https://api.brandplus.com.br/api/v1"

# Neon PostgreSQL Database Configuration (Placeholder template)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
PGHOST="HOST"
PGHOST_UNPOOLED="HOST"
PGUSER="USER"
PGDATABASE="DATABASE"
PGPASSWORD="PASSWORD"


